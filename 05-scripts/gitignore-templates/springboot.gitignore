
# ====================================
# === Spring Boot / Java .gitignore 
# ====================================

# --- Build Output & Compiled Code ---
# Ignore all compiled Java class files
*.class

# Ignore build tool output directories
target/
build/
bin/
out/

# Ignore generated package files
*.jar
*.war
*.ear

# --- IDE / Editor ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/
*.code-workspace
*.sublime-project
*.sublime-workspace

# --- Secrets / Environment Variables (CRITICAL) ---
# Ignore local environment files and property overrides
.env
application-local.properties
application-local.yml

# --- Maven / Gradle ---
# Ignore Maven build logs
.mvn/
# Ignore Gradle build cache
.gradle/
# BUT, do NOT ignore the wrappers themselves (this is important)
!gradle/wrapper/gradle-wrapper.jar
!mvn/wrapper/maven-wrapper.jar

# --- Logs ---
*.log
hs_err_pid*
replay_pid*

# --- OS / System ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Test Reports ---
# Ignore reports generated by test runners
surefire-reports/
test-output/
jacoco.exec
*.hprof

# --- Docker / Containerization ---
Dockerfile.local
docker-compose.override.yml
docker-data/
.env.docker
